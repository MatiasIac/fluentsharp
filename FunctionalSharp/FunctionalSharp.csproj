<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Authors>Matías Iacono</Authors>
    <Product>Fluent Sharp</Product>
    <Copyright>Matías Iacono</Copyright>
    <RepositoryUrl>https://github.com/MatiasIac/fluentsharp</RepositoryUrl>
    <Description>Fluent C# 14 conditions, value composition, awaited collection operations, equality comparers, data mapping, pipelines, and lightweight patterns for .NET 10.</Description>
    <PackageId>FluentSharp</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>2.0.0</Version>
    <PackageProjectUrl>https://github.com/MatiasIac/fluentsharp</PackageProjectUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>fluent;extensions;linq;collections;functional;csharp</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../readme.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
