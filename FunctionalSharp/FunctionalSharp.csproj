<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Authors>Matías Iacono</Authors>
    <Product>Fluent Sharp</Product>
    <Copyright>Matías Iacono</Copyright>
    <RepositoryUrl>https://github.com/MatiasIac/fluentsharp</RepositoryUrl>
    <Description>Lightweight fluent extensions for C#: conditional operations, collection pipelines, LINQ equality comparers, data reader mapping, and chains of responsibility. Targets .NET Standard 2.0.</Description>
    <PackageId>FluentSharp</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.7</Version>
    <PackageProjectUrl>https://github.com/MatiasIac/fluentsharp</PackageProjectUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>fluent;extensions;linq;collections;functional;csharp</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../readme.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
