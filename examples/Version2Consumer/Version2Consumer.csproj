<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <FluentSharpVersion Condition="'$(FluentSharpVersion)' == ''">2.0.0</FluentSharpVersion>
    <RestoreSources>$(MSBuildThisFileDirectory)../../artifacts/packages</RestoreSources>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../artifacts/consumer-cache</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentSharp" Version="$(FluentSharpVersion)" />
  </ItemGroup>
</Project>
